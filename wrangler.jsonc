{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinitchuri",
  "account_id": "dba7a9b5ed108516b714250de2a0dd0f",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
